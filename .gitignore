# ============================================================
# UOC2 存档修改器 —— 忽略规则
# 原则：
#   1) 可重建的运行时产物、机器本地配置、个人存档不入库；
#   2) 随包分发的解释器（python/）必须入库，保证"解压即用"。
# ============================================================

# ---- 运行时状态目录（解包工作区 / 参考列表 / last_save.txt 等）----
data/

# ---- 成品 zip（构建产物，不入库）----
dist/

# ---- 终检脚本的输出（生成物）----
docs/证据脚本/v6_check.txt

# ---- 本机配置（由 config 引导生成，含本机路径）----
config/config.yml
config.yml

# ---- 存档样本与备份（含游戏自身约定的 <存档名>_BACKUP.usg）----
*.usg

# ---- Python 缓存 / 虚拟环境 ----
# 注意：不要忽略 *.pyd —— python/Lib/site-packages/yaml/_yaml*.pyd 是必需的 C 扩展
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---- 编辑器与系统文件 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
